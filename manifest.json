{
  "manifest_version": 3,
  "name": "WriteAssist – Free Grammar, Rewrite & Translate",
  "short_name": "WriteAssist",
  "version": "1.0.0",
  "description": "Grammarly-style writing helper for every site: grammar & spelling fixes, AI rewrite, reply suggestions and translation — free tools only.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WriteAssist",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "offscreen",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.languagetool.org/*",
    "https://translate.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/textmap.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "Open WriteAssist panel for the focused text box"
    },
    "fix-all": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Fix the whole focused text box with AI"
    }
  },
  "options_page": "popup/popup.html"
}